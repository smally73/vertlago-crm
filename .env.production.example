# Vit exclusivement sur le serveur (jamais commité, .gitignore le couvre).
# Généré automatiquement avec des secrets aléatoires par
# scripts/promote-to-production.sh au premier déploiement.
#
# Lu à deux niveaux :
# - par docker-compose.prod.yml lui-même (--env-file .env.production),
#   pour les variables ${...} (POSTGRES_*)
# - par le conteneur backend (env_file: .env.production), qui a besoin
#   en plus de DATABASE_URL / JWT_SECRET / etc.

POSTGRES_USER=vertlago
POSTGRES_PASSWORD=change-moi-mot-de-passe-postgres-production
POSTGRES_DB=vertlago_crm

# Hôte "db" = nom du service dans docker-compose.prod.yml, pas localhost
DATABASE_URL=postgres://vertlago:change-moi-mot-de-passe-postgres-production@db:5432/vertlago_crm

JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire-production

PORT=4000
FRONTEND_ORIGIN=https://admin.vertlago.com
NODE_ENV=production
