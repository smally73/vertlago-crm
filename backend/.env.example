# Copier ce fichier en ".env" et adapter les valeurs

# Base de données PostgreSQL
DATABASE_URL=postgres://vertlago:vertlago@localhost:5432/vertlago_crm

# Secret utilisé pour signer les tokens JWT (change-le en production, garde-le secret)
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Port sur lequel l'API écoute
PORT=4000

# Origine autorisée pour le frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173
