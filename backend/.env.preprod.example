# Copié automatiquement en ".env" par scripts/promote-to-preprod.sh (dotenv ne lit
# que ".env" par défaut, pas ".env.preprod"). Adapter si besoin après génération.
# Ce fichier ne doit jamais être commité avec de vraies valeurs sensibles.

# Base de données PostgreSQL préprod (docker-compose.preprod.yml, port distinct de dev)
DATABASE_URL=postgres://vertlago:vertlago@localhost:5433/vertlago_crm_preprod

# Secret JWT distinct de dev et de prod — génère le tien :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire-preprod

# Port sur lequel l'API préprod écoute (distinct du port 4000 de dev)
PORT=4100

# Origine autorisée pour le frontend préprod (CORS)
FRONTEND_ORIGIN=http://localhost:5273

NODE_ENV=production
